{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local inventory, verified SSH and explicitly approved provisioning in the main window.",
  "windows": ["main"],
  "permissions": [
    "allow-list-servers",
    "allow-get-server",
    "allow-create-server",
    "allow-update-server",
    "allow-delete-server",
    "allow-get-ssh-metadata",
    "allow-select-ssh-key",
    "allow-configure-ssh-credential",
    "allow-unlock-ssh-key",
    "allow-open-server-session",
    "allow-close-server-session",
    "allow-cancel-server-operation",
    "allow-test-server-connection",
    "allow-trust-server-host-key",
    "allow-get-server-info",
    "allow-get-docker-capabilities",
    "allow-get-server-metrics",
    "allow-list-ssh-keys",
    "allow-get-ssh-key",
    "allow-generate-ssh-key",
    "allow-import-ssh-key",
    "allow-rename-ssh-key",
    "allow-delete-ssh-key",
    "allow-get-ssh-public-key",
    "allow-export-ssh-public-key",
    "allow-assign-ssh-key-to-server",
    "allow-list-servers-using-ssh-key",
    "allow-get-server-ssh-key-id",
    "allow-get-provisioning-preflight",
    "allow-generate-provisioning-plan",
    "allow-start-server-provisioning",
    "allow-get-provisioning-run",
    "allow-list-provisioning-runs",
    "allow-cancel-server-provisioning",
    "allow-get-docker-service-status",
    "allow-grant-docker-access",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
